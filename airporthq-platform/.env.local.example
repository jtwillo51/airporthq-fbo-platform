# AI panels run in sample mode by default: pre-written responses, no API call,
# no spend. Everything is explorable with no key at all.
#
# To switch the same panels onto real Claude calls, set BOTH of these:
#   AI_MODE=live
#   ANTHROPIC_API_KEY=sk-ant-...
# The key is read only inside /api/ai/* route handlers and never reaches the
# browser.
# AI_MODE=live
# ANTHROPIC_API_KEY=

# Optional: pin the demo's "today" so screenshots stay reproducible.
# Defaults to 2026-08-19; set to "live" to track the real clock.
# Data past this date is never shown.
# NEXT_PUBLIC_DEMO_TODAY=2026-08-19
